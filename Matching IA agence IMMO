        "jsCode": "// 1. Récupérer le texte brut généré par le nœud Gemini\nconst rawText = items[0].json.content.parts[0].text;\n\n// 2. Nettoyer le texte si l'IA a inclus des balises de code Markdown ```json ... ```\nlet cleanedText = rawText.trim();\nif (cleanedText.startsWith(\"```\")) {\n  cleanedText = cleanedText.replace(/^```json\\s*/i, \"\").replace(/```$/, \"\").trim();\n}\n\ntry {\n  // 3. Convertir la chaîne nettoyée en un vrai tableau/objet JSON\n  const emailDataArray = JSON.parse(cleanedText);\n  \n  // On prend le premier élément du tableau d'emails généré\n  const emailData = emailDataArray[0];\n\n  // 4. Retourner les éléments séparés pour le nœud Gmail\n  return [\n    {\n      json: {\n        destinataire: emailData.email,\n        sujet: emailData.sujet,\n        corps_email: emailData.corps_email\n      }\n    }\n  ];\n\n} catch (error) {\n  // En cas d'erreur de parsing (si l'IA a renvoyé un texte mal formaté)\n  return [\n    {\n      json: {\n        error: \"Impossible de parser le JSON de Gemini\",\n        rawText: rawText\n      }\n    }\n  ];\n}"
