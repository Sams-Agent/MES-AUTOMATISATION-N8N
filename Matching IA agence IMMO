        "jsCode": "// 1. Récupérer les données réelles du déclencheur Tally via la syntaxe correcte n8n\nconst tallyData = $('Declencheur').first().json;\n\n// Extraction propre des champs du nouveau bien via leurs clés Tally uniques\nconst newProperty = {\n  type: tallyData.question_DeGyl5?.value || \"Non spécifié\",\n  city: tallyData.question_lREZPW?.value || \"Non spécifié\",\n  surface: tallyData.question_RL9l7J?.value || \"Non spécifié\",\n  rooms: tallyData.question_oOjQ4V?.value || 0,\n  price: tallyData.question_G0Py2o?.value || 0,\n  strongPoints: tallyData.question_O0NyW8?.value || \"Non spécifié\",\n  availableFrom: tallyData.question_V86ykv?.value || \"Non spécifié\"\n};\n\n// 2. Récupérer la liste des acheteurs (provenant du nœud Google Sheets actuel qui est le parent direct)\nconst buyers = items.map(item => item.json);\n\n// 3. Formater la liste des acheteurs en texte structuré pour le prompt de l'IA\nlet buyersListText = \"\";\nbuyers.forEach((buyer, index) => {\n  // Prise en compte de l'espace potentiel dans la clé \"Nom \" de ton Google Sheets\n  const buyerName = buyer[\"Nom \"] || buyer[\"Nom\"] || 'Inconnu';\n  \n  buyersListText += `Acheteur #${index + 1}:\\n`;\n  buyersListText += `- Nom : ${buyerName}\\n`;\n  buyersListText += `- Email : ${buyer[\"Email\"] || 'N/A'}\\n`;\n  buyersListText += `- Ville souhaitée : ${buyer[\"Ville souhaitée\"] || 'N/A'}\\n`;\n  buyersListText += `- Type souhaité : ${buyer[\"Type souhaité\"] || 'N/A'}\\n`;\n  buyersListText += `- Budget Max : ${buyer[\"Budget Max\"] || '0'} FCFA\\n`;\n  buyersListText += `- Pièces min : ${buyer[\"Pieces min\"] || '0'}\\n`;\n  buyersListText += `- Surface min (m²) : ${buyer[\"Surface (m²)\"] || 'N/A'}\\n`;\n  buyersListText += `- Statut : ${buyer[\"Statut\"]?.trim() || 'N/A'}\\n`;\n  buyersListText += `---------------------------\\n`;\n});\n\n// 4. Retourner l'objet combiné pour le nœud Gemini suivant\nreturn [\n  {\n    json: {\n      matchContext: {\n        property: newProperty,\n        buyersRawList: buyersListText\n      }\n    }\n  }\n];"
