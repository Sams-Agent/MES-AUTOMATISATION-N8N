      "parameters": {
        "jsCode": "const items = $input.all();\nconst aujourd_hui = $now.toFormat('dd/MM/yyyy');\n\nconst candidaturesDuJour = items.filter(item => {\n  return item.json['Date ']?.trim() === aujourd_hui;\n});\n\nif (candidaturesDuJour.length === 0) {\n  return [{ json: { aucune_candidature: true } }];\n}\n\nreturn candidaturesDuJour;"
