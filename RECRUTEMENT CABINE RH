        "jsCode": "const candidature = $('Filtrer candidature du jour').item.json;\nconst recruteur = $input.item.json;\nconst aujourd_hui = $now.toFormat('dd/MM/yyyy');\n\n// Remonter à toutes les candidatures pour compter celles du jour sur ce poste\nconst toutesLesCandidatures = $('Retrouver toutes les candidatures').all();\n\nconst candidaturesDuJourSurCePoste = toutesLesCandidatures.filter(item => {\n  const dateItem = item.json['Date ']?.trim();\n  const posteItem = item.json['Poste']?.trim().toLowerCase();\n  return dateItem === aujourd_hui && posteItem === candidature.Poste?.toLowerCase();\n});\n\nconst liste = candidaturesDuJourSurCePoste.map(c =>\n  `- ${c.json['Nom']} (${c.json['Email']})`\n).join('\\n');\n\nreturn [{\n  json: {\n    poste: candidature.Poste,\n    email_recruteur: recruteur['Email du recruteur '],\n    nombre: candidaturesDuJourSurCePoste.length,\n    liste_candidats: liste\n  }\n}];"
      },
